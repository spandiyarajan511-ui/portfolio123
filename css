/* =========================================================
   PANDIYARAJAN S - PORTFOLIO STYLESHEET
   Sections: 1 Tokens · 2 Base · 3 Layout · 4 Header
             5 Hero · 6 About · 7 Skills · 8 Contact
             9 Footer · 10 Animations · 11 Responsive
   ========================================================= */

/* ---------- 1. DESIGN TOKENS ---------- */
:root {
  --cream:    #F7F3EB;
  --tan:      #D9C3A5;
  --brown:    #604936;
  --charcoal: #29251F;
  --white:    #FFFFFF;

  --font-display: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
  --font-body:    "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;

  --radius-sm: 12px;
  --radius-lg: 22px;
  --shadow-soft: 0 10px 30px rgba(41, 37, 31, 0.10);
  --shadow-lift: 0 18px 40px rgba(41, 37, 31, 0.16);
  --ease: 0.3s ease;
}

/* ---------- 2. BASE ---------- */
*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 5rem; }

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--charcoal);
  background: var(--cream);
}

h1, h2, h3 {
  margin: 0;
  font-family: var(--font-display);
  line-height: 1.12;
  letter-spacing: -0.01em;
}

p { margin: 0; }
ul { margin: 0; padding: 0; list-style: none; }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }

:focus-visible {
  outline: 3px solid var(--brown);
  outline-offset: 3px;
  border-radius: 6px;
}

.skip-link {
  position: absolute;
  left: 1rem;
  top: -4rem;
  z-index: 100;
  padding: 0.6rem 1rem;
  background: var(--charcoal);
  color: var(--white);
  border-radius: 8px;
}
.skip-link:focus { top: 1rem; }

/* ---------- 3. LAYOUT HELPERS ---------- */
.container {
  width: min(1120px, 100% - 3rem);
  margin-inline: auto;
}

.section { padding: clamp(4rem, 9vw, 7rem) 0; }

.section-title {
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  color: var(--brown);
}

/* ---------- 4. HEADER / NAV ---------- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(247, 243, 235, 0.92);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid rgba(96, 73, 54, 0.15);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 4.5rem;
}

.logo {
  font-family: var(--font-display);
  font-size: 1.7rem;
  font-weight: 700;
  color: var(--brown);
  transition: color var(--ease);
}
.logo:hover { color: var(--charcoal); }
.logo--light { color: var(--tan); }
.logo--light:hover { color: var(--white); }

.nav__list { display: flex; gap: 0.4rem; }

.nav__list a {
  position: relative;
  display: block;
  padding: 0.5rem 0.9rem;
  font-size: 0.98rem;
  color: var(--charcoal);
  transition: color var(--ease);
}
.nav__list a::after {
  content: "";
  position: absolute;
  left: 0.9rem;
  right: 0.9rem;
  bottom: 0.2rem;
  height: 2px;
  background: var(--brown);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--ease);
}
.nav__list a:hover { color: var(--brown); }
.nav__list a:hover::after { transform: scaleX(1); }

/* ---------- 5. HERO ---------- */
.hero {
  position: relative;
  overflow: hidden;
  padding: clamp(3.5rem, 8vw, 6.5rem) 0;
}

/* Subtle background decorations */
.hero::before,
.hero::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
}
.hero::before {
  width: 26rem; height: 26rem;
  top: -9rem; right: -7rem;
  background: var(--tan);
  opacity: 0.35;
}
.hero::after {
  width: 14rem; height: 14rem;
  bottom: -6rem; left: -4rem;
  border: 2px solid var(--tan);
  opacity: 0.7;
}

.hero__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: clamp(2rem, 6vw, 5rem);
}

.eyebrow {
  margin-bottom: 1.1rem;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  color: var(--brown);
}

.hero h1 {
  font-size: clamp(2.8rem, 7vw, 5.2rem);
  color: var(--charcoal);
}

.hero__subtitle {
  margin-top: 1rem;
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 2.6vw, 1.75rem);
  font-style: italic;
  color: var(--brown);
}

.hero__desc {
  max-width: 34rem;
  margin-top: 1.4rem;
  color: rgba(41, 37, 31, 0.82);
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2.2rem;
}

/* Buttons */
.btn {
  display: inline-block;
  padding: 0.9rem 1.9rem;
  font-weight: 600;
  border: 2px solid var(--brown);
  border-radius: 999px;
  transition: transform var(--ease), background var(--ease),
              color var(--ease), box-shadow var(--ease);
}
.btn:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }

.btn--primary { background: var(--brown); color: var(--white); }
.btn--primary:hover { background: var(--charcoal); border-color: var(--charcoal); }

.btn--ghost { background: transparent; color: var(--brown); }
.btn--ghost:hover { background: var(--brown); color: var(--white); }

/* Profile photo: simple 4:5 frame */
.hero__photo {
  justify-self: center;
  width: 100%;
  max-width: 350px;
  margin: 0;
  animation: fade-in 0.9s ease both;
}

.hero__photo img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: center top;
  background-color: var(--tan);        /* fallback while the image loads */
  border: 2px solid var(--brown);
  border-radius: 12px;
  box-shadow: var(--shadow-soft);
  transition: transform var(--ease), box-shadow var(--ease);
}
.hero__photo img:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lift);
}

/* ---------- 6. ABOUT ---------- */
.about { background: var(--white); }

.about__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2rem, 6vw, 5rem);
  align-items: start;
}

.about__lead {
  margin-top: 1.6rem;
  font-family: var(--font-display);
  font-size: clamp(1.25rem, 2.4vw, 1.6rem);
  line-height: 1.5;
  color: var(--charcoal);
}

.about__body {
  display: grid;
  gap: 1.4rem;
  padding-left: clamp(0rem, 3vw, 2.5rem);
  border-left: 2px solid var(--tan);
  color: rgba(41, 37, 31, 0.85);
}

.chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }

.chips li {
  padding: 0.35rem 1rem;
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--brown);
  background: var(--cream);
  border: 1px solid var(--tan);
  border-radius: 999px;
  transition: background var(--ease), color var(--ease);
}
.chips li:hover { background: var(--brown); color: var(--white); }

/* ---------- 7. SKILLS ---------- */
.skills__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 1.5rem;
  margin-top: 3rem;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  padding: 2rem 1.6rem;
  background: var(--white);
  border: 1px solid rgba(217, 195, 165, 0.7);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
}
.card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lift);
  border-color: var(--brown);
}

.card__icon {
  display: grid;
  place-items: center;
  width: 3.4rem;
  height: 3.4rem;
  margin-bottom: 0.4rem;
  font-family: "Consolas", "Courier New", monospace;
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--cream);
  background: var(--brown);
  border-radius: 14px;
  transition: background var(--ease), color var(--ease);
}
.card:hover .card__icon { background: var(--tan); color: var(--charcoal); }

.card__tag {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--brown);
}

.card h3 { font-size: 1.7rem; }
.card p { font-size: 0.98rem; color: rgba(41, 37, 31, 0.8); }

/* ---------- 8. CONTACT ---------- */
.contact {
  position: relative;
  overflow: hidden;
  padding: clamp(4rem, 9vw, 7rem) 0;
  color: var(--cream);
  background: var(--charcoal);
}
.contact::before {
  content: "";
  position: absolute;
  width: 24rem; height: 24rem;
  top: -10rem; left: -8rem;
  border-radius: 50%;
  background: var(--brown);
  opacity: 0.35;
  pointer-events: none;
}
.contact .container { position: relative; }

.contact__title {
  max-width: 14ch;
  font-size: clamp(2.4rem, 6vw, 4.2rem);
  color: var(--white);
}

.contact__desc {
  max-width: 34rem;
  margin-top: 1.4rem;
  color: rgba(247, 243, 235, 0.8);
}

.contact__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 1.2rem;
  margin-top: 3rem;
}

.contact-card {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  height: 100%;
  padding: 1.5rem;
  background: rgba(247, 243, 235, 0.06);
  border: 1px solid rgba(217, 195, 165, 0.35);
  border-radius: var(--radius-lg);
  transition: transform var(--ease), background var(--ease), border-color var(--ease);
}
.contact-card:hover {
  transform: translateY(-6px);
  background: rgba(247, 243, 235, 0.12);
  border-color: var(--tan);
}
.contact-card:focus-visible { outline-color: var(--tan); }

.contact-card__icon {
  display: grid;
  place-items: center;
  width: 2.8rem;
  height: 2.8rem;
  margin-bottom: 0.7rem;
  font-weight: 700;
  color: var(--charcoal);
  background: var(--tan);
  border-radius: 50%;
  transition: transform var(--ease);
}
.contact-card:hover .contact-card__icon { transform: scale(1.1); }

.contact-card__label {
  font-family: var(--font-display);
  font-size: 1.3rem;
  color: var(--white);
}

.contact-card__value {
  font-size: 0.95rem;
  color: var(--tan);
  overflow-wrap: anywhere;
}

/* ---------- 9. FOOTER ---------- */
.site-footer {
  padding: 1.8rem 0;
  font-size: 0.92rem;
  color: rgba(247, 243, 235, 0.7);
  background: #1d1a16;
  border-top: 1px solid rgba(217, 195, 165, 0.2);
}

.footer__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem 2rem;
}

/* ---------- 10. ANIMATIONS ---------- */
@keyframes fade-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: none; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
  }
}

/* ---------- 11. RESPONSIVE ---------- */

/* Tablet */
@media (max-width: 860px) {
  .hero__inner,
  .about__grid { grid-template-columns: 1fr; }

  .hero__photo { order: -1; }          /* image above text, centered */
  .hero__text { text-align: center; }
  .hero__desc { margin-inline: auto; }
  .hero__actions { justify-content: center; }

  .about__body {
    padding-left: 0;
    padding-top: 1.6rem;
    border-left: 0;
    border-top: 2px solid var(--tan);
  }
}

/* Mobile */
@media (max-width: 560px) {
  .container { width: min(1120px, 100% - 2rem); }
  .nav { flex-direction: column; justify-content: center; gap: 0.2rem; padding: 0.6rem 0; }
  .nav__list a { padding: 0.4rem 0.6rem; font-size: 0.92rem; }
  .hero__photo { max-width: 260px; }
  .btn { width: 100%; text-align: center; }
  .footer__inner { flex-direction: column; text-align: center; }
}
